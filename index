<!doctype html>
<html lang="ms">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Modul kendiri Design Thinking + AI untuk pelajar sekolah menengah: tema Kelas Selesa.">
<style>:root{color-scheme:light;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0;font:14px system-ui,sans-serif}img{max-width:100%}[hidden]{display:none!important}</style>
</head>
<body>
<title>Jejak Inovator</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Baloo+2:wght@800&display=swap">
<style>
/* Layout: clay-style learning app. Peta (journey map) with a water "pipe" that fills per unit; each unit is a 4-step stepper (Teori → Game → Misi → Lencana). Single, deliberate light look. */
:root{
  color-scheme:light;
  --bg:#E6F3FA; --bg2:#D2EAF6; --card:#FFFFFF; --ink:#0F2F45; --muted:#46667A; --line:#C6E0ED;
  --primary:#1672C4; --primary-d:#0E5596; --aqua:#22A9B8; --aqua-soft:#D8F3F5;
  --accent:#F07B1D; --accent-d:#BF5C0C; --on-accent:#2A1300; --sun:#FFC63A; --sun-soft:#FFF2CC;
  --good:#1B8E59; --good-soft:#DDF5E8; --bad:#C93F2A; --bad-soft:#FDE3DE;
  --p0:#5B6CD6; --p1:#DE4F78; --p2:#D98A06; --p3:#E8A90A; --p4:#13998F; --p5:#1672C4; --p6:#F07B1D;
  --f-display:"Bricolage Grotesque","Trebuchet MS",system-ui,sans-serif;
  --f-body:"Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --r-lg:26px; --r:18px; --r-sm:12px;
  --clay:8px 10px 22px rgba(22,90,140,.14), inset -3px -4px 8px rgba(15,47,69,.05), inset 3px 3px 6px rgba(255,255,255,.9);
  --clay-sm:4px 6px 12px rgba(22,90,140,.12), inset 2px 2px 4px rgba(255,255,255,.9);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.6;background-image:radial-gradient(circle at 12% 8%,rgba(34,169,184,.14) 0 180px,transparent 181px),radial-gradient(circle at 92% 30%,rgba(255,198,58,.18) 0 140px,transparent 141px)}
h1,h2,h3{font-family:var(--f-display);line-height:1.1;text-wrap:balance;margin:0;color:var(--ink)}
p{margin:0}
a{color:var(--primary-d);font-weight:500}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:8px}
svg.i{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}

/* top bar */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:rgba(230,243,250,.92);backdrop-filter:blur(8px);border-bottom:2px solid var(--line)}
.bar-in{max-width:900px;margin:0 auto;padding-block:10px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;align-items:center;gap:10px}
.brand{display:flex;align-items:center;gap:8px;font-family:var(--f-display);font-weight:800;font-size:1.25rem;background:none;border:0;padding:4px 0;min-height:44px}
.brand svg{width:30px;height:30px}
.spacer{flex:1}
.navbtn{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0 14px;border-radius:99px;border:2px solid transparent;background:transparent;font-weight:600;font-size:.9rem;color:var(--muted);transition:background .2s,color .2s}
.navbtn[aria-current="page"]{background:var(--card);color:var(--primary-d);border-color:var(--line);box-shadow:var(--clay-sm)}
.xp{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:99px;background:var(--sun-soft);color:#7A5200;font-weight:700;font-size:.9rem;font-variant-numeric:tabular-nums;border:2px solid #F5DC8F}
.xp svg{width:18px;height:18px;stroke:#B07A00}
@media (max-width:560px){.navbtn span.lbl{display:none}.brand .bt{display:none}}

.wrap{max-width:900px;margin:0 auto;padding-block:24px 64px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.view{display:grid;gap:22px;animation:rise .35s ease-out}
@keyframes rise{from{opacity:.4;transform:translateY(8px)}to{opacity:1;transform:none}}

/* clay primitives */
.card{background:var(--card);border-radius:var(--r-lg);box-shadow:var(--clay);border:2px solid #fff;padding:22px;display:grid;gap:14px;min-width:0}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border-radius:16px;border:0;font-weight:700;font-size:1rem;background:var(--primary);color:#fff;box-shadow:0 5px 0 var(--primary-d);transition:transform .15s ease-out,box-shadow .15s ease-out;position:relative;top:0}
.btn:hover{transform:translateY(-2px);box-shadow:0 7px 0 var(--primary-d)}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 var(--primary-d)}
.btn.accent{background:var(--accent);color:var(--on-accent);box-shadow:0 5px 0 var(--accent-d)}
.btn.accent:hover{box-shadow:0 7px 0 var(--accent-d)}
.btn.accent:active{box-shadow:0 1px 0 var(--accent-d)}
.btn.ghost{background:var(--card);color:var(--ink);box-shadow:0 4px 0 var(--line);border:2px solid var(--line)}
.btn.ghost:active{box-shadow:0 0 0 var(--line)}
.btn.sm{min-height:44px;padding:0 16px;font-size:.92rem}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.row{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.eyebrow{font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;font-weight:600;color:var(--muted)}
.lead{color:var(--muted);max-width:62ch}
.note{font-size:.88rem;color:var(--muted)}

/* hero */
.hero{display:grid;grid-template-columns:1.3fr 1fr;gap:20px;align-items:center;background:linear-gradient(135deg,#1672C4,#22A9B8);color:#fff;border-radius:var(--r-lg);padding:28px;box-shadow:var(--clay);position:relative;overflow:hidden}
.hero h1{color:#fff;font-size:clamp(2.2rem,6vw,3.4rem);font-weight:800}
.hero p{color:#E4F6FB;max-width:44ch}
.hero .eyebrow{color:#BFEAF3}
.hero-txt{display:grid;gap:12px;min-width:0}
.hero .btn.accent{justify-self:start}
.hero-art{display:grid;place-items:center}
.hero-art svg{width:min(220px,100%);height:auto}
.wave{position:absolute;inset:auto 0 0 0;height:36px;opacity:.25}
@media (max-width:640px){.hero{grid-template-columns:1fr}.hero-art{order:-1}.hero-art svg{width:140px}}
.bob{animation:bob 3.2s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-8px)}}

.statrow{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.stat{background:var(--card);border-radius:var(--r);box-shadow:var(--clay-sm);border:2px solid #fff;padding:14px;display:grid;gap:2px;text-align:center}
.stat b{font-family:var(--f-display);font-size:1.7rem;font-weight:800;color:var(--primary-d);font-variant-numeric:tabular-nums;line-height:1.1}
.stat span{font-size:.8rem;color:var(--muted)}

/* journey map */
.map{position:relative;display:grid;gap:14px;padding-left:64px}
.pipe{position:absolute;left:25px;top:28px;bottom:28px;width:12px;border-radius:99px;background:var(--bg2);border:2px solid var(--line);overflow:hidden}
.pipe i{position:absolute;left:0;right:0;top:0;background:linear-gradient(180deg,var(--aqua),var(--primary));border-radius:99px;transition:height .8s ease}
.station{position:relative;display:flex;align-items:center;gap:14px;text-align:left;width:100%;background:var(--card);border:2px solid #fff;border-radius:var(--r);box-shadow:var(--clay-sm);padding:14px 16px;min-height:76px;transition:transform .2s ease-out}
.station:not(:disabled):hover{transform:translateX(4px)}
.station:disabled{cursor:not-allowed;background:#F1F7FA;box-shadow:none;border-color:var(--line)}
.node{position:absolute;left:-58px;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;display:grid;place-items:center;color:#fff;border:4px solid var(--bg);box-shadow:0 4px 0 rgba(15,47,69,.15)}
.node svg{width:22px;height:22px}
.station:disabled .node{background:#B7CCD8!important}
.st-txt{flex:1;min-width:0;display:grid;gap:2px}
.st-txt b{font-family:var(--f-display);font-size:1.15rem;font-weight:700}
.st-txt span{font-size:.86rem;color:var(--muted)}
.st-state{flex:0 0 auto;font-size:.78rem;font-weight:700;padding:4px 10px;border-radius:99px}
.st-state.done{background:var(--good-soft);color:var(--good)}
.st-state.now{background:var(--sun-soft);color:#7A5200}
.st-state.lock{background:var(--bg2);color:var(--muted)}

/* unit header + stepper */
.uhead{display:flex;gap:16px;align-items:center}
.ubadge{width:64px;height:64px;border-radius:20px;display:grid;place-items:center;color:#fff;flex:0 0 auto;box-shadow:0 5px 0 rgba(15,47,69,.18)}
.ubadge svg{width:32px;height:32px}
.uhead h2{font-size:clamp(1.6rem,4.5vw,2.2rem);font-weight:800}
.steps{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 8px}
.step{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;border-radius:99px;border:2px solid var(--line);background:var(--card);font-weight:600;font-size:.88rem;white-space:nowrap;color:var(--muted);transition:all .2s}
.step .dot{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:var(--bg2);font-size:.75rem;font-weight:700;color:var(--muted)}
.step[aria-current="step"]{border-color:var(--primary);color:var(--primary-d);box-shadow:var(--clay-sm)}
.step[aria-current="step"] .dot{background:var(--primary);color:#fff}
.step.ok .dot{background:var(--good);color:#fff}

/* mascot tip */
.tip{display:flex;gap:12px;align-items:flex-start}
.tip svg.m{width:54px;height:54px;flex:0 0 auto}
.bubble{background:var(--card);border:2px solid var(--line);border-radius:18px 18px 18px 4px;padding:10px 14px;font-size:.92rem;box-shadow:var(--clay-sm);min-width:0}
.bubble b{color:var(--primary-d)}

/* theory */
.theory{display:grid;gap:14px;max-width:70ch}
.theory ul{margin:0;padding-left:22px;display:grid;gap:6px}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.tile{border-radius:var(--r-sm);padding:12px 14px;background:var(--bg);border:2px solid var(--line);display:grid;gap:2px}
.tile b{font-family:var(--f-display);font-size:1.15rem;color:var(--primary-d)}
.tile span{font-size:.86rem;color:var(--muted)}
.formula{font-family:var(--f-display);font-size:1.15rem;font-weight:600;padding:14px 16px;border-radius:var(--r-sm);background:var(--aqua-soft);border:2px dashed var(--aqua)}

/* games */
.q{display:grid;gap:10px;padding:14px;border-radius:var(--r-sm);background:var(--bg);border:2px solid transparent;transition:border-color .2s}
.q.right{border-color:var(--good);background:var(--good-soft)}
.q.wrong{border-color:var(--bad);background:var(--bad-soft);animation:shake .35s}
@keyframes shake{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
.q-t{font-weight:500}
.qs{display:grid;gap:10px}
.opts{display:flex;flex-wrap:wrap;gap:8px}
.opt{min-height:44px;min-width:44px;padding:0 16px;border-radius:14px;border:2px solid var(--line);background:var(--card);font-weight:600;font-size:.92rem;box-shadow:0 3px 0 var(--line);transition:transform .12s,background .15s}
.opt:active{transform:translateY(3px);box-shadow:none}
.opt[aria-pressed="true"]{background:var(--primary);border-color:var(--primary);color:#fff;box-shadow:0 3px 0 var(--primary-d)}
.result{padding:12px 16px;border-radius:var(--r-sm);font-weight:600;display:flex;gap:10px;align-items:center}
.result.ok{background:var(--good-soft);color:var(--good)}
.result.no{background:var(--bad-soft);color:var(--bad)}
.timer{width:84px;height:84px;border-radius:50%;display:grid;place-items:center;font-family:var(--f-display);font-size:2rem;font-weight:800;color:var(--primary-d);font-variant-numeric:tabular-nums;background:conic-gradient(var(--aqua) var(--pct,100%),var(--bg2) 0);position:relative}
.timer::after{content:"";position:absolute;inset:8px;border-radius:50%;background:var(--card)}
.timer span{position:relative;z-index:1}
.ideas{display:flex;flex-wrap:wrap;gap:8px}
.idea{background:var(--sun-soft);border:2px solid #F5DC8F;border-radius:12px;padding:6px 12px;font-size:.9rem;animation:pop .3s ease-out}
@keyframes pop{from{transform:scale(.6);opacity:0}to{transform:none;opacity:1}}
.meter{height:16px;border-radius:99px;background:var(--bg2);overflow:hidden;border:2px solid var(--line)}
.meter i{display:block;height:100%;background:linear-gradient(90deg,var(--aqua),var(--good));transition:width .35s}
.sample{font-size:.95rem;padding:12px 14px;border-radius:var(--r-sm);background:var(--bg);border:2px dashed var(--line)}

/* forms */
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
label.f{display:grid;gap:6px;font-size:.9rem;font-weight:600;min-width:0}
label.f small{font-weight:400;color:var(--muted)}
input[type=text],textarea,select{width:100%;min-height:48px;border:2px solid var(--line);background:var(--bg);border-radius:14px;padding:10px 14px;font-size:1rem;transition:border-color .2s,box-shadow .2s}
textarea{min-height:84px;resize:vertical}
input:focus,textarea:focus,select:focus{border-color:var(--primary);outline:none;box-shadow:0 0 0 4px rgba(22,114,196,.15);background:#fff}
input[type=file]{font-size:.9rem}
.persona{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.pcard{text-align:left;border:2px solid var(--line);background:var(--card);border-radius:var(--r);padding:14px;display:grid;gap:6px;box-shadow:0 4px 0 var(--line);transition:transform .15s}
.pcard:hover{transform:translateY(-2px)}
.pcard b{font-family:var(--f-display);font-size:1.15rem}
.pcard span{font-size:.85rem;color:var(--muted)}
.pcard .av{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:#fff}
.pcard[aria-pressed="true"]{border-color:var(--primary);background:#EAF4FD;box-shadow:0 4px 0 var(--primary)}
.pdetail{display:grid;gap:12px;padding:16px;border-radius:16px;border:1px solid var(--line);background:#F5FAFC;border-left:5px solid var(--pc,var(--primary))}
.pdetail h3{font-size:1.2rem}
.pdetail .av{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:#fff;flex:0 0 auto}
.pdetail dl{margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.pdetail dt{font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:var(--muted)}
.pdetail dd{margin:2px 0 0;font-size:.92rem}
.statement{font-family:var(--f-display);font-size:1.2rem;font-weight:600;padding:14px 16px;border-radius:var(--r-sm);background:var(--aqua-soft);border:2px solid var(--aqua)}
.sub{font-family:var(--f-display);font-size:1.15rem;font-weight:700;display:flex;gap:8px;align-items:center}
.sub .num{width:30px;height:30px;border-radius:10px;background:var(--primary);color:#fff;display:grid;place-items:center;font-size:.95rem}

/* prompt box */
.prompt{border-radius:var(--r);padding:16px;display:grid;gap:12px;background:#0F2F45;color:#E3F1F8}
.prompt-h{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.prompt-h b{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:#8FD3E0;display:flex;gap:8px;align-items:center}
.prompt-t{white-space:pre-wrap;font-size:.92rem;margin:0;overflow-wrap:anywhere;line-height:1.55}
.prompt-t mark{background:#FFC63A;color:#2A1300;border-radius:5px;padding:0 4px;font-weight:600}
.prompt textarea{background:#fff;color:var(--ink)}
.ai-links{font-size:.82rem;color:#A9C7D6}
.ai-links a{color:#FFD56B}
.copied{font-size:.85rem;font-weight:600;color:#7EE2B0}

.pad{background:#fff;border:2px solid var(--line);border-radius:var(--r);width:100%;max-width:100%;aspect-ratio:3/2;touch-action:none;display:block;cursor:crosshair;box-shadow:inset 0 2px 6px rgba(15,47,69,.06)}
.upimg{max-width:100%;border-radius:var(--r);border:2px solid var(--line)}
details summary{cursor:pointer;min-height:44px;display:flex;align-items:center;gap:8px;font-weight:700}

/* finish */
.missing{display:grid;gap:6px}
.miss-item{display:flex;gap:8px;align-items:center;font-size:.92rem;color:var(--bad)}
.medal{width:56px;height:56px;border-radius:50%;display:grid;place-items:center;color:#fff;flex:0 0 auto;box-shadow:0 4px 0 rgba(15,47,69,.18),inset 0 -4px 0 rgba(0,0,0,.12);border:3px solid #fff}
.medal svg{width:26px;height:26px}
.medal.off{background:#C9D9E2!important}

/* modal */
.modal{position:fixed;inset:0;z-index:20;background:rgba(15,47,69,.5);display:grid;place-items:center;padding:20px}
.modal-c{background:var(--card);border-radius:28px;padding:28px 24px;max-width:380px;width:100%;text-align:center;display:grid;gap:12px;justify-items:center;box-shadow:0 20px 50px rgba(15,47,69,.3);animation:pop .4s cubic-bezier(.2,1.4,.4,1)}
.modal-c .medal{width:96px;height:96px}
.modal-c .medal svg{width:44px;height:44px}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:21}

/* portfolio */
.badges{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:12px}
.bdg{display:grid;justify-items:center;gap:6px;text-align:center;font-size:.85rem;font-weight:600}
.pf dl{margin:0;display:grid;gap:12px}
.pf dt{font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.pf dd{margin:2px 0 0;overflow-wrap:anywhere}
.imgs{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.cert{position:relative;border-radius:var(--r-lg);padding:34px 22px;text-align:center;display:grid;gap:10px;background:#fff;border:6px solid var(--sun);box-shadow:var(--clay),inset 0 0 0 4px #fff,inset 0 0 0 6px var(--line);overflow:hidden}
.cert .big{font-family:var(--f-display);font-size:clamp(2rem,6vw,2.8rem);font-weight:800;color:var(--primary-d);overflow-wrap:anywhere;line-height:1.1}
.cert .seal{justify-self:center}
.cert small{color:var(--muted)}
table.score{width:100%;border-collapse:collapse;font-size:.92rem;font-variant-numeric:tabular-nums}table.score th,table.score td{text-align:left;padding:10px 12px;border-bottom:2px solid var(--line)}table.score th{font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}table.score td:last-child,table.score th:last-child{text-align:right;font-weight:600}table.score tfoot td{font-family:var(--f-display);font-size:1.15rem;font-weight:800;color:var(--primary-d);border-bottom:0}
.confirm{display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:12px;border-radius:var(--r-sm);background:var(--bad-soft)}
.foot{margin-top:32px;font-size:.82rem;color:var(--muted);text-align:center}
/* ---- layout v4: top bar + sidebar Perjalanan + hero + stepper ---- */
:root{--bg:#EEF6FA;--line:#D6E6EE;--primary:#0E7AA6;--primary-d:#0A5D80;--navy:#2E5577;
  --clay:0 8px 28px rgba(15,60,90,.08);--clay-sm:0 3px 12px rgba(15,60,90,.07)}
body{background:linear-gradient(180deg,#F3F9FC 0%,#E6F2F8 100%) fixed;background-color:var(--bg)}
h1,h2,h3{letter-spacing:-.01em}
.card{border:1px solid var(--line);border-radius:22px;box-shadow:var(--clay);padding:24px}
.btn{border-radius:14px;background:linear-gradient(135deg,#0E7AA6,#14A0B8);box-shadow:0 6px 16px rgba(14,122,166,.25)}
.btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(14,122,166,.3)}
.btn:active{transform:translateY(1px);box-shadow:0 3px 8px rgba(14,122,166,.25)}
.btn:disabled{background:linear-gradient(135deg,#7FC3D7,#9ED8E2);box-shadow:none;opacity:1;color:#fff}
.btn.accent{background:linear-gradient(135deg,#F07B1D,#F59A3C);box-shadow:0 6px 16px rgba(240,123,29,.28)}
.btn.ghost{background:#fff;border:1px solid var(--line);box-shadow:var(--clay-sm)}
.bar{background:rgba(255,255,255,.85);border-bottom:1px solid var(--line)}
.bar-in{max-width:1200px;gap:28px;padding-block:12px}
.brand{gap:10px;text-align:left}
.brand-ic{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#0E7AA6,#14A0B8);display:grid;place-items:center;color:#fff;flex:0 0 auto}
.brand-ic svg{width:20px;height:20px}
.brand-t{display:grid;line-height:1.15}
.brand-t b{font-family:var(--f-display);font-size:1.1rem;font-weight:800}

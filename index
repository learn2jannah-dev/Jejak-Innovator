/* ---------- unit ---------- */
function stepOkFn(i){const steps=stepsOf(i);return s=>s==='teori'?!!S.seenT[i]:GAMES[s]?attempted(s):s==='misi'?missingFields(i).length===0:!!S.done[i]}
function goStep(i,k){const steps=stepsOf(i),si=stepIdx[i]??0;if(steps[si]==='teori'&&k!==si){S.seenT[i]=1;save()}stepIdx[i]=k;renderUnit();scrollToSteps()}
function renderUnit(){
  const i=route.i,u=U[i],steps=stepsOf(i);
  if(stepIdx[i]===undefined)stepIdx[i]=S.done[i]?steps.length-1:0;
  const si=stepIdx[i],step=steps[si],ok=stepOkFn(i);
  const pct=Math.round(steps.filter(ok).length/steps.length*100);
  const [sic,slbl,stitle]=stepInfo(i,step);
  main.innerHTML=`<div class="view">
   <section class="uhero"><div class="hchips"><span class="hchip">${META[i].phase}</span><span class="hchip">${ic('clock')}${META[i].min} min</span><span class="hchip">${pct}% lengkap</span></div>
    <h1>${u.title}</h1><p>${META[i].lead}</p></section>
   <nav class="steps" aria-label="Langkah unit">${steps.map((s,k)=>{const lb=stepInfo(i,s)[1]+(GAMES[s]&&u.games.length>1?' '+(u.games.indexOf(s)+1):'');return `<button class="step ${ok(s)&&k!==si?'ok':''}" data-step="${k}" ${k===si?'aria-current="step"':''}><span class="dot">${ok(s)&&k!==si?'✓':k+1}</span>${lb}</button>`}).join('')}</nav>
   <section class="card" id="stepBody"><div class="card-h"><span class="card-ic">${ic(sic)}</span><div style="min-width:0"><span class="eyebrow">${slbl} · ${si+1} / ${steps.length}</span><h3>${stitle}</h3></div></div>${stepBody(i,step)}</section>
   <div class="unav">
    <button class="btn ghost sm" id="prevStep" ${si===0?'disabled':''}>${ic('arrowL')}Kembali</button>
    ${si<steps.length-1?`<button class="btn sm" id="nextStep">Seterusnya${ic('arrowR')}</button>`:(S.done[i]?(i<6?`<button class="btn sm" id="nextUnit">Unit seterusnya${ic('arrowR')}</button>`:`<button class="btn accent sm" id="toPf">${ic('trophy')}Lihat sijil</button>`):'')}
   </div></div>`;
  const go=k=>goStep(i,k);
  main.querySelectorAll('[data-step]').forEach(b=>b.onclick=()=>go(+b.dataset.step));
  const pv=document.getElementById('prevStep');if(pv)pv.onclick=()=>go(si-1);
  const nx=document.getElementById('nextStep');if(nx)nx.onclick=()=>go(si+1);
  const nu=document.getElementById('nextUnit');if(nu)nu.onclick=()=>nav('unit-'+(i+1));
  const tp=document.getElementById('toPf');if(tp)tp.onclick=()=>nav('portfolio');
  main.querySelectorAll('[data-goto]').forEach(b=>b.onclick=()=>go(+b.dataset.goto));
  bindStep(i,step);
  renderBar();
}
function scrollToSteps(){const el=document.getElementById('stepBody');if(!el)return;const top=el.getBoundingClientRect().top;if(top<80||top>innerHeight*.6)el.scrollIntoView({behavior:RM?'auto':'smooth',block:'start'})}
function stepBody(i,step){
  const u=U[i];
  if(step==='teori')return `<div class="theory">${u.theory}</div>`;
  if(GAMES[step])return gameHTML(step);
  if(step==='misi')return u.mission();
  return finishHTML(i);
}
function bindStep(i,step){
  if(GAMES[step])bindGames();
  if(step==='misi'){bindFields();bindPrompts();if(U[i].after)U[i].after()}
  if(step==='lencana')bindFinish(i);
}

/* ---------- fields & prompts ---------- */
function field(k,label,opt={}){
  const val=esc(S.f[k]||'');const hint=opt.hint?`<small>${opt.hint}</small>`:'';
  const ctl=opt.area?`<textarea id="f_${k}" data-f="${k}" placeholder="${esc(opt.ph||'')}">${val}</textarea>`
    :`<input type="text" id="f_${k}" data-f="${k}" value="${val}" placeholder="${esc(opt.ph||'')}">`;
  return `<label class="f" for="f_${k}">${label}${hint}${ctl}</label>`;
}
function bindFields(){main.querySelectorAll('[data-f]').forEach(el=>el.addEventListener('input',()=>{S.f[el.dataset.f]=el.value;save();refreshLive();updateStepDots()}))}
function updateStepDots(){if(route.name!=='unit')return;renderSide();const i=route.i,steps=stepsOf(i);const k=steps.indexOf('misi');if(stepIdx[i]===k)return;const b=main.querySelector(`[data-step="${k}"]`);if(!b)return;const ok=missingFields(i).length===0;b.classList.toggle('ok',ok);b.querySelector('.dot').textContent=ok?'✓':k+1}
function promptBox(id,label,note){
  return `<div class="prompt"><div class="prompt-h"><b>${ic('sparkle')}${label}</b><span class="row"><span class="copied" id="cp_${id}" hidden>Disalin</span><button class="btn accent sm" data-copy="${id}">${ic('copy')}Salin Prompt</button></span></div>
   <p class="prompt-t" data-prompt="${id}"></p><textarea data-fallback="${id}" hidden readonly></textarea>
   <p class="ai-links">${note?note+' ':''}Tampal di tool AI yang dibenarkan guru: <a href="https://gemini.google.com" target="_blank" rel="noopener">Gemini</a> · <a href="https://copilot.microsoft.com" target="_blank" rel="noopener">Copilot</a> · <a href="https://chatgpt.com" target="_blank" rel="noopener">ChatGPT</a></p></div>`;
}
const promptHTML=t=>esc(t).replace(/⟦([^⟧]*)⟧/g,'<mark>$1</mark>');
function refreshLive(){
  main.querySelectorAll('[data-prompt]').forEach(el=>{el.innerHTML=promptHTML(P[el.dataset.prompt]())});
  main.querySelectorAll('[data-live="stmt"]').forEach(el=>{el.innerHTML=promptHTML(stmt())});
}
function bindPrompts(){
  refreshLive();
  main.querySelectorAll('[data-copy]').forEach(b=>b.onclick=()=>{
    const id=b.dataset.copy,txt=P[id](),c=document.getElementById('cp_'+id);
    const say=(t,col)=>{c.textContent=t;c.style.color=col||'';c.hidden=false};
    if(txt.includes('⟦')&&!b.dataset.warned){b.dataset.warned=1;say('Ada ruang kosong (kuning). Isi dahulu, atau tekan sekali lagi.','#FFD56B');return}
    const fb=()=>{const ta=main.querySelector(`[data-fallback="${id}"]`);ta.hidden=false;ta.value=txt;ta.focus();ta.select();say('Teks dipilih. Tekan Ctrl+C untuk salin.')};
    try{navigator.clipboard.writeText(txt).then(()=>{say('Disalin');setTimeout(()=>c.hidden=true,1800)}).catch(fb)}catch(e){fb()}
  });
}


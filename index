    head('Pitch & Refleksi');kv('Cara berfungsi',v('h_cara'));kv('Keunikan',v('h_unik'));kv('Slogan',v('h_slogan'));kv('Skrip pitch',v('h_skrip'));
    kv('Refleksi',v('r_ai')?`AI bantu aku dalam ${v('r_ai')}, tetapi aku sendiri yang ${v('r_saya')}.`:'');
    if(doneCount()===7){const c=await drawCert();doc.addPage('a4','landscape');doc.addImage(c.toDataURL('image/jpeg',.92),'JPEG',10,10,277,277*1414/2000)}
    const n=doc.getNumberOfPages();for(let k=1;k<=n;k++){doc.setPage(k);doc.setFontSize(8);doc.setTextColor(120,140,150);const pw=doc.internal.pageSize.getWidth(),ph=doc.internal.pageSize.getHeight();doc.text(`Jejak Inovator · ${certInfo().code} · halaman ${k}/${n}`,pw/2,ph-8,{align:'center'})}
    await offerFile(fileBase()+'-Portfolio.pdf',doc.output('blob'),msg);
  }finally{btn.disabled=false}
}

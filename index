  const all=doneCount()===7,d=S.finishedAt?new Date(S.finishedAt):new Date();
  const dateStr=d.toLocaleDateString('ms-MY',{day:'numeric',month:'long',year:'numeric'});
  const code='JI-'+d.getFullYear()+String(d.getMonth()+1).padStart(2,'0')+String(d.getDate()).padStart(2,'0')+'-'+String(total()).padStart(3,'0');
  const row=(t,val)=>val?`<div><dt>${t}</dt><dd>${esc(val)}</dd></div>`:'';
  return `<div class="view">
   <div class="uhead"><div class="ubadge" style="background:var(--p6)">${ic('trophy')}</div><div style="min-width:0"><span class="eyebrow">Portfolio inovasi</span><h2>${esc(v('p_nama')||'Inovasi aku')}</h2></div></div>
   ${all?`<section class="cert"><svg viewBox="0 0 60 60" class="seal" width="70" height="70" aria-hidden="true"><circle cx="30" cy="30" r="27" fill="#FFC63A"/><circle cx="30" cy="30" r="21" fill="none" stroke="#fff" stroke-width="2.5" stroke-dasharray="3 3"/><path d="m30 15 4.3 8.8 9.7 1.4-7 6.8 1.7 9.6L30 37.1l-8.7 4.5 1.7-9.6-7-6.8 9.7-1.4z" fill="#fff"/></svg>
     <span class="eyebrow">Sijil Penyertaan</span><p>Dengan ini disahkan bahawa</p><p class="big">${esc(S.name||'Inovator')}</p>
     <p>telah melengkapkan modul <b>Jejak Inovator: Design Thinking + AI</b><br>dengan inovasi <b>${esc(v('p_nama'))}</b> untuk ${esc(v('pengguna'))}.</p>
     <p><span class="xp">${ic('star')}${total()}/${MAXALL()} markah · Tahap ${levelOf(total())}</span></p><small>${dateStr} · No. ${code}</small></section>
`
   :`<section class="card"><div class="row" style="gap:16px"><div class="medal off">${ic('lock')}</div><p><b>Sijil terbuka selepas 7 unit lengkap.</b> Kamu sudah siapkan ${doneCount()}/7.</p></div></section>`}
   <section class="card dlcard"><div class="sub">${ic('download')}Muat turun</div>
    <p class="note">${all?'Simpan sijil dan portfolio kamu untuk dihantar kepada guru.':'Portfolio boleh dimuat turun bila-bila masa. Sijil terbuka selepas 7 unit lengkap.'}</p>
    <div class="row"><button class="btn accent" id="dlCert" ${all?'':'disabled'}>${ic('trophy')}Sijil (PNG)</button><button class="btn" id="dlPf">${ic('book')}Portfolio (PDF)</button></div>
    <p class="note" id="dlMsg" hidden aria-live="polite"></p></section>
   <section class="card"><div class="row" style="justify-content:space-between"><div class="sub">${ic('star')}Kad Markah</div><span class="xp">${total()}/${MAXALL()}</span></div><div style="overflow-x:auto"><table class="score"><thead><tr><th>Game</th><th>Unit</th><th>Markah</th></tr></thead><tbody>${Object.keys(GAMES).map(k=>{const ui=U.findIndex(u=>u.games.includes(k));return `<tr><td>${GAMES[k].title}</td><td>${U[ui].short}</td><td>${attempted(k)?S.games[k].score+'/'+gMax(k):'Belum dijawab'}</td></tr>`}).join('')}</tbody><tfoot><tr><td colspan="2">Jumlah</td><td>${total()}/${MAXALL()}</td></tr></tfoot></table></div><p class="note">Tahap ikut peratus markah: Perintis (bawah 30%), Pereka Muda (30–59%), Inovator (60–84%), Inovator Cemerlang (85% ke atas). Tunjuk kad markah atau sijil kepada guru untuk kiraan pemenang.</p></section>
   <section class="card"><div class="sub">${ic('medal')}Lencana</div><div class="badges">${BADGES.map((b,i)=>`<div class="bdg"><div class="medal ${S.done[i]?'':'off'}" style="background:${U[i].color}">${ic(S.done[i]?U[i].icon:'lock')}</div>${b}</div>`).join('')}</div></section>
   <section class="card pf"><div class="sub">${ic('book')}Perjalanan inovasi</div><dl>
    ${row('Fokus',v('fokus'))}
    ${row('Pengguna',cap(v('pengguna'))+(v('situasi')?' — '+v('situasi'):''))}
    ${row('5W1H',[['Who','w_who'],['What','w_what'],['When','w_when'],['Where','w_where'],['Why','w_why'],['How','w_how']].filter(x=>v(x[1])).map(x=>x[0]+': '+v(x[1])).join(' · '))}
    ${row('Penyataan masalah',v('d_final'))}${row('Idea Sprint',S.sprint.join('; '))}
    ${row('Idea dipilih',v('i_idea')+(v('i_why')?' (kerana '+v('i_why')+')':''))}
    ${row('Ciri SCAMPER',[v('i_c1'),v('i_c2')].filter(Boolean).join('; '))}${row('Kelemahan dibaiki',v('i_juri'))}
    ${row('Produk',[v('p_nama'),v('p_bentuk'),v('p_saiz'),v('p_warna'),v('p_bahan')].filter(Boolean).join(' · '))}
    ${row('Ciri utama',[v('p_c1'),v('p_c2'),v('p_c3')].filter(Boolean).join('; '))}</dl>
    ${S.sketch||S.image?`<div class="imgs">${S.sketch?'<figure style="margin:0;display:grid;gap:6px"><img class="upimg" src="'+S.sketch+'" alt="Lakaran produk"><figcaption class="note">Lakaran</figcaption></figure>':''}${S.image?'<figure style="margin:0;display:grid;gap:6px"><img class="upimg" src="'+S.image+'" alt="Gambar produk daripada AI"><figcaption class="note">Gambar AI</figcaption></figure>':''}</div>`:''}
    <dl>${row('Maklum balas ('+(v('t_siapa')||'-')+')',[v('t_suka')&&'Suka: '+v('t_suka'),v('t_risau')&&'Risau: '+v('t_risau'),v('t_kalau')&&'Bagaimana kalau: '+v('t_kalau')].filter(Boolean).join(' · '))}
    ${row('Penambahbaikan',v('t_baiki'))}${row('Pitch',[v('h_cara'),v('h_unik')].filter(Boolean).join(' · '))}${row('Skrip pitch',v('h_skrip'))}${row('Slogan',v('h_slogan'))}
    ${row('Refleksi',v('r_ai')?'AI bantu aku dalam '+v('r_ai')+', tetapi aku sendiri yang '+v('r_saya')+'.':'')}</dl>
    <div class="row"><button class="btn" id="copyPf">${ic('copy')}Salin portfolio (teks)</button><span class="miss-item" id="pfOk" hidden style="color:var(--good)">${ic('check')}Disalin</span></div>
    <textarea id="pfFallback" hidden readonly></textarea></section>
   </div>`;
}
function portfolioText(){
  return [`PORTFOLIO INOVASI – ${S.name||''}`,`Produk: ${v('p_nama')}`,`Fokus: ${v('fokus')}`,`Pengguna: ${v('pengguna')} (${v('situasi')})`,
   `5W1H: Who ${v('w_who')}; What ${v('w_what')}; When ${v('w_when')}; Where ${v('w_where')}; Why ${v('w_why')}; How ${v('w_how')}`,
   `Masalah: ${v('d_final')}`,`Idea Sprint: ${S.sprint.join('; ')}`,`Idea dipilih: ${v('i_idea')} – ${v('i_why')}`,`Ciri SCAMPER: ${v('i_c1')}; ${v('i_c2')}`,
   `Produk: ${v('p_bentuk')}, ${v('p_saiz')}, ${v('p_warna')}, ${v('p_bahan')}; ciri: ${v('p_c1')}, ${v('p_c2')}, ${v('p_c3')}`,
   `Maklum balas (${v('t_siapa')}): Suka ${v('t_suka')}; Risau ${v('t_risau')}; Bagaimana kalau ${v('t_kalau')}`,`Penambahbaikan: ${v('t_baiki')}`,
   `Pitch: ${v('h_skrip')||v('h_cara')+' | '+v('h_unik')}`,`Slogan: ${v('h_slogan')}`,`Refleksi: AI bantu aku dalam ${v('r_ai')}, tetapi aku sendiri yang ${v('r_saya')}.`,`MARKAH: ${total()}/${MAXALL()} | `+Object.keys(GAMES).map(k=>GAMES[k].title+' '+(S.games[k]?S.games[k].score:0)+'/'+gMax(k)).join('; ')+` | Unit lengkap: ${doneCount()}/7`].join('\n');
}
function bindPortfolio(){
  const msg=document.getElementById('dlMsg');
  const dc=document.getElementById('dlCert');if(dc&&!dc.disabled)dc.onclick=()=>downloadCert(dc,msg);
  const dp=document.getElementById('dlPf');if(dp)dp.onclick=()=>downloadPortfolio(dp,msg);
  document.getElementById('copyPf').onclick=()=>{const t=portfolioText();const ok=()=>{document.getElementById('pfOk').hidden=false};
    const fb=()=>{const ta=document.getElementById('pfFallback');ta.hidden=false;ta.value=t;ta.style.minHeight='200px';ta.select()};
    try{navigator.clipboard.writeText(t).then(ok).catch(fb)}catch(e){fb()}};

}

if(S.sprintStarted&&!attempted('g3a')){const ideas=S.sprint.slice();S.games.g3a={score:Math.min(ideas.length,SPRINT_MAX)*PTS,ideas,max:SPRINT_MAX*PTS,at:new Date().toISOString()};S.sprintStarted=0;save()}
route=parseHash();render();
})();

const main=document.getElementById('main');
S.seenT=S.seenT||{};
let route={name:'peta'},stepIdx={};
const unlocked=i=>i===0||!!S.done[i-1];
const doneCount=()=>S.done.filter(Boolean).length;
function parseHash(){const h=(location.hash||'').slice(1);const m=h.match(/^unit-(\d)$/);
  if(m&&unlocked(+m[1]))return {name:'unit',i:+m[1]};if(h==='portfolio')return {name:'portfolio'};return {name:'peta'}}
function nav(h){if(location.hash==='#'+h)render();else location.hash=h}
window.addEventListener('hashchange',()=>{if(S.sprintStarted&&!attempted('g3a')){const ideas=S.sprint.slice();S.games.g3a={score:Math.min(ideas.length,SPRINT_MAX)*PTS,ideas,max:SPRINT_MAX*PTS,at:new Date().toISOString()};S.sprintStarted=0;save()}
route=parseHash();render();window.scrollTo({top:0,behavior:RM?'auto':'smooth'})});
document.querySelectorAll('[data-route]').forEach(b=>b.onclick=()=>nav(b.dataset.route));

function renderBar(){
  document.getElementById('hpills').innerHTML=`<span class="hpill u" title="Unit lengkap">${ic('book')}${doneCount()}/7</span><span class="hpill sc" title="Jumlah markah">${ic('zap')}${total()} markah</span>`;
  document.querySelectorAll('.navbtn').forEach(b=>b.setAttribute('aria-current',(b.dataset.route===route.name)?'page':'false'));
  renderSide();
}
function sideSteps(i){
  const steps=stepsOf(i),si=stepIdx[i]??0,ok=stepOkFn(i),u=U[i];
  return `<div class="side-steps" role="tablist" aria-label="Langkah ${u.short}">${steps.map((st,k)=>{const [icn,lb]=stepInfo(i,st);const name=stepInfo(i,st)[2];const isOk=ok(st)&&k!==si;
    return `<button class="ss ${isOk?'ok':''}" role="tab" data-sstep="${k}" aria-selected="${k===si}"><span class="ss-ic">${ic(isOk?'check':icn)}</span><span class="ss-t"><small>${lb}</small>${esc(name)}</span></button>`}).join('')}</div>`;
}
function renderSide(){
  const side=document.getElementById('side');
  side.innerHTML=`<p class="eyebrow side-h">Perjalanan</p><div class="side-list">${U.map((u,i)=>{const ul=unlocked(i),done=!!S.done[i],cur=route.name==='unit'&&route.i===i;
    return `<button class="side-item ${done?'done':''}" data-unit="${i}" ${ul?'':'disabled'} ${cur?'aria-current="page"':''}><span class="side-dot">${done?ic('check'):ul?i+1:ic('lock')}</span><span class="side-t"><small>${META[i].phase}</small><b>${u.short}</b></span></button>${cur?sideSteps(i):''}`}).join('')}</div>
   <button class="side-pf" data-pf ${route.name==='portfolio'?'aria-current="page"':''}>${ic('medal')}Portfolio & Sijil</button>`;
  side.querySelectorAll('[data-unit]').forEach(b=>b.onclick=()=>nav('unit-'+b.dataset.unit));
  side.querySelector('[data-pf]').onclick=()=>nav('portfolio');
  side.querySelectorAll('[data-sstep]').forEach(b=>b.onclick=()=>goStep(route.i,+b.dataset.sstep));
}

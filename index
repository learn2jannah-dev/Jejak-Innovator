/* ---------- games (sekali jawab, markah dikunci) ---------- */
const ans={};
const attempted=id=>!!(S.games[id]&&typeof S.games[id]==='object');
function scoreTag(id){const r=S.games[id];return `<span class="st-state done">${r.score}/${r.max} markah</span>`}
function gameHTML(id){
  const g=GAMES[id],done=attempted(id),r=S.games[id]||{};
  const head=`<div class="row">${done?scoreTag(id):`<span class="st-state now">Maks ${gMax(id)} markah</span>`}</div>`;
  const once=done?`<p class="result ok">${ic('lock')}Jawapan sudah dihantar. Markah kamu: ${r.score}/${r.max}. Tekan Seterusnya untuk sambung.</p>`
    :`<p class="bubble"><b>Perhatian:</b> game ini hanya boleh dijawab <b>sekali</b>. Markah terus dikira dan tidak boleh diubah.</p>`;
  if(g.type==='classify'){
    const a=done?r.ans:(ans[id]||{});

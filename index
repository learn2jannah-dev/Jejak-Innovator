@media (max-width:420px){.brand-t{display:none}}

.shell{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:260px minmax(0,1fr);gap:32px;align-items:start;padding-block:28px 64px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.side{position:sticky;top:calc(env(safe-area-inset-top,0px) + 88px);display:grid;gap:6px}
.side-h{padding:0 12px 6px}
.side-list{display:grid;gap:4px}
.side-item{display:flex;align-items:center;gap:12px;width:100%;text-align:left;border:0;background:transparent;border-radius:14px;padding:10px 12px;min-height:56px;transition:background .2s}
.side-item:not(:disabled):hover{background:rgba(255,255,255,.6)}
.side-item[aria-current="page"]{background:#fff;box-shadow:var(--clay-sm)}
.side-item:disabled{cursor:not-allowed;opacity:.5}
.side-dot{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:.82rem;background:#E3EEF3;color:var(--muted);flex:0 0 auto}
.side-dot svg{width:14px;height:14px}
.side-item[aria-current="page"] .side-dot{background:var(--navy);color:#fff}
.side-item.done .side-dot{background:var(--good);color:#fff}
.side-t{display:grid;line-height:1.2;min-width:0}
.side-t small{font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--muted)}
.side-t b{font-size:1rem;font-weight:700}
.side-pf{margin-top:10px;display:flex;align-items:center;gap:10px;min-height:48px;padding:0 14px;border-radius:14px;border:1.5px dashed var(--line);background:transparent;font-weight:600;text-align:left}
.side-pf svg{width:18px;height:18px}
.side-pf[aria-current="page"]{background:#fff;border-style:solid;border-color:var(--primary);color:var(--primary-d)}
.content{min-width:0;display:grid;gap:22px}
.side-steps{display:grid;gap:2px;margin:2px 0 8px 25px;padding-left:14px;border-left:2px solid var(--line)}
.ss{display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:0;background:transparent;border-radius:12px;padding:8px 10px;min-height:48px;color:var(--ink);transition:background .15s}
.ss:hover{background:rgba(255,255,255,.7)}
.ss[aria-selected="true"]{background:var(--navy);color:#fff}
.ss-ic{width:28px;height:28px;border-radius:9px;display:grid;place-items:center;background:#E3EEF3;color:var(--navy);flex:0 0 auto}
.ss-ic svg{width:16px;height:16px}
.ss[aria-selected="true"] .ss-ic{background:rgba(255,255,255,.18);color:#fff}
.ss.ok .ss-ic{background:var(--good-soft);color:var(--good)}
.ss-t{display:grid;line-height:1.25;font-size:.9rem;font-weight:600;min-width:0}
.ss-t small{font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;opacity:.7}
.side{max-height:calc(100vh - 110px);overflow-y:auto;padding-right:4px}

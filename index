.topnav{display:flex;gap:4px}
.navbtn{border-radius:10px;font-size:.95rem;color:var(--ink);padding:0 12px}
.navbtn[aria-current="page"]{background:var(--aqua-soft);box-shadow:none;border-color:transparent;color:var(--primary-d)}
.hpills{display:flex;gap:8px}
.navbtn,.brand-t b{white-space:nowrap}
.hpill{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;border-radius:99px;border:1px solid var(--line);background:#fff;font-weight:700;font-size:.85rem;font-variant-numeric:tabular-nums;white-space:nowrap}
.hpill svg{width:16px;height:16px}
.hpill.sc{background:var(--sun-soft);border-color:#F3DFA4;color:#6E4A00}

function stepInfo(i,s){if(s==='teori')return ['book','Teori','Fahami dulu'];if(s==='misi')return ['edit',META[i].misiLbl,META[i].misiTitle];if(s==='lencana')return ['medal','Lencana','Terima lencana'];return ['game','Game',GAMES[s].title]}

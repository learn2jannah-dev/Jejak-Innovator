U[4].after=()=>{
  const c=document.getElementById('pad'),x=c.getContext('2d');
  x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);
  if(S.sketch){const im=new Image();im.onload=()=>x.drawImage(im,0,0,c.width,c.height);im.src=S.sketch}
  x.lineCap='round';x.lineJoin='round';x.lineWidth=6;x.strokeStyle='#0F2F45';
  let drawing=false;const pt=e=>{const r=c.getBoundingClientRect();return [(e.clientX-r.left)*c.width/r.width,(e.clientY-r.top)*c.height/r.height]};
  c.addEventListener('pointerdown',e=>{drawing=true;c.setPointerCapture(e.pointerId);const [a,b]=pt(e);x.beginPath();x.moveTo(a,b)});
  c.addEventListener('pointermove',e=>{if(!drawing)return;const [a,b]=pt(e);x.lineTo(a,b);x.stroke()});
  const end=()=>{if(!drawing)return;drawing=false;S.sketch=c.toDataURL('image/jpeg',.7);save();document.getElementById('padNote').textContent=saveWarn?'Storan penuh, lakaran tidak disimpan.':'Lakaran disimpan.'};
  c.addEventListener('pointerup',end);c.addEventListener('pointercancel',end);
  document.getElementById('padClear').onclick=()=>{x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);S.sketch='';save();document.getElementById('padNote').textContent='Lakaran dipadam.'};
  document.getElementById('imgUp').onchange=e=>{const file=e.target.files[0];if(!file)return;const r=new FileReader();
    r.onload=()=>{const im=new Image();im.onload=()=>{const s=Math.min(1,640/Math.max(im.width,im.height));const cv=document.createElement('canvas');cv.width=Math.round(im.width*s);cv.height=Math.round(im.height*s);cv.getContext('2d').drawImage(im,0,0,cv.width,cv.height);S.image=cv.toDataURL('image/jpeg',.8);save();renderUnit()};im.src=r.result};r.readAsDataURL(file)};
};
